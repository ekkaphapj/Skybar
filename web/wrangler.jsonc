{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "cottage-skybar-pos",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cottage-skybar-pos-db",
      "database_id": "aed14ec7-abb4-4ab1-ad6e-d8b8084d055c"
    }
  ]
}
